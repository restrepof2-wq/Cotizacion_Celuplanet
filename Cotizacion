  <script>
    // Configuración Inicial del Estado de la Propuesta
    let selectedPlanName = 'Crecimiento';
    let selectedPlanHours = 8;
    let selectedPlanPrice = 1200000;

    // Contadores del estimador
    const tasks = {
      products: 0,
      prices: 0,
      banners: 0,
      apps: 0
    };

    // Tiempos en minutos por cada unidad de tarea
    const taskTimes = {
      products: 15,
      prices: 5,
      banners: 90,
      apps: 120
    };

    // Inicialización de la fecha actual
    document.addEventListener('DOMContentLoaded', () => {
      const today = new Date();
      const dd = String(today.getDate()).padStart(2, '0');
      const mm = String(today.getMonth() + 1).padStart(2, '0');
      const yyyy = today.getFullYear();
      document.getElementById('current-date').innerText = `${dd}/${mm}/${yyyy}`;
      
      // Actualizar la calculadora inicial
      calculateEstimate();
    });

    // Función para cambiar de Plan haciendo click en las tarjetas
    function selectPlan(name, hours, price) {
      selectedPlanName = name;
      selectedPlanHours = hours;
      selectedPlanPrice = price;

      // Actualizar estilo visual de las tarjetas
      document.querySelectorAll('.plan-card').forEach(card => card.classList.remove('active'));
      
      let selectedCardId = 'plan-basico';
      if (name === 'Crecimiento') selectedCardId = 'plan-crecimiento';
      if (name === 'Premium') selectedCardId = 'plan-premium';
      document.getElementById(selectedCardId).classList.add('active');

      // Sincronizar el slider
      document.getElementById('hours-slider').value = hours;
      document.getElementById('slider-hours-value').innerText = `${hours} horas`;

      // Sincronizar el dropdown de firmas
      const dropdown = document.getElementById('form-selected-plan');
      if (name === 'Básico') dropdown.value = 'Básico';
      if (name === 'Crecimiento') dropdown.value = 'Crecimiento';
      if (name === 'Premium') dropdown.value = 'Premium';

      // Actualizar la recomendación de la calculadora
      updateRecommendationText(hours, price, false);
    }

    // Manejar el cambio manual del slider de horas
    function handleSliderChange(hours) {
      hours = parseInt(hours);
      selectedPlanHours = hours;
      selectedPlanPrice = hours * 150000;
      
      document.getElementById('slider-hours-value').innerText = `${hours} horas`;

      // Desactivar tarjetas para activar la adecuada
      document.querySelectorAll('.plan-card').forEach(card => card.classList.remove('active'));
      
      const dropdown = document.getElementById('form-selected-plan');
      if (hours === 4) {
        document.getElementById('plan-basico').classList.add('active');
        dropdown.value = 'Básico';
        selectedPlanName = 'Básico';
      } else if (hours === 8) {
        document.getElementById('plan-crecimiento').classList.add('active');
        dropdown.value = 'Crecimiento';
        selectedPlanName = 'Crecimiento';
      } else if (hours === 12) {
        document.getElementById('plan-premium').classList.add('active');
        dropdown.value = 'Premium';
        selectedPlanName = 'Premium';
      } else {
        dropdown.value = 'Personalizado';
        selectedPlanName = 'Personalizado';
      }

      updateRecommendationText(hours, selectedPlanPrice, true);
    }

    // Sincronizar el selector de plan del formulario
    function syncSelectionFromDropdown(val) {
      if (val === 'Básico') selectPlan('Básico', 4, 600000);
      else if (val === 'Crecimiento') selectPlan('Crecimiento', 8, 1200000);
      else if (val === 'Premium') selectPlan('Premium', 12, 1800000);
      else {
        // Personalizado
        const currentHours = parseInt(document.getElementById('hours-slider').value);
        handleSliderChange(currentHours);
      }
    }

    // Controladores de los contadores de tareas del estimador
    function updateCounter(type, change) {
      tasks[type] = Math.max(0, tasks[type] + change);
      document.getElementById(`count-${type}`).innerText = tasks[type];
      calculateEstimate();
    }

    // Lógica matemática para estimar horas y costo según tareas seleccionadas
    function calculateEstimate() {
      let totalMinutes = 0;
      for (const key in tasks) {
        totalMinutes += tasks[key] * taskTimes[key];
      }

      const rawHours = totalMinutes / 60;
      let hoursNeeded = Math.ceil(rawHours);
      
      // Si hay estimación pero es menor a 4, redondeamos a 4 (que es la bolsa mínima)
      if (hoursNeeded > 0 && hoursNeeded < 4) {
        hoursNeeded = 4;
      }

      const formattedMinutes = totalMinutes % 60;
      const formattedHours = Math.floor(rawHours);

      // Mostrar el tiempo estimado de forma legible
      let timeText = '0 horas';
      if (totalMinutes > 0) {
        timeText = `${formattedHours}h ${formattedMinutes > 0 ? formattedMinutes + 'm' : ''}`;
      }
      document.getElementById('total-time-estimate').innerText = timeText;

      // Calcular costo estimado basado en horas recomendadas
      const estimatedCost = hoursNeeded * 150000;
      document.getElementById('total-cost-estimate').innerText = `$${estimatedCost.toLocaleString('es-MX')}`;

      // Sugerir un plan en base a las horas necesarias
      if (hoursNeeded > 0) {
        updateRecommendationText(hoursNeeded, estimatedCost, true);
        
        // Sincronizar el slider e interfaz con la recomendación estimada
        document.getElementById('hours-slider').value = Math.min(32, Math.max(4, hoursNeeded));
        document.getElementById('slider-hours-value').innerText = `${hoursNeeded} horas`;
        
        selectedPlanHours = hoursNeeded;
        selectedPlanPrice = estimatedCost;
      }
    }

    // Actualizar dinámicamente el mensaje de recomendación del plan
    function updateRecommendationText(hours, price, isCustom) {
      const recBox = document.getElementById('recommendation-text');
      let planText = '';

      if (hours <= 4) {
        planText = `Recomendamos el <strong>Plan Soporte Básico</strong> (4 Horas - $600.000)`;
        if (isCustom && hours === 4) selectPlan('Básico', 4, 600000);
      } else if (hours <= 8) {
        planText = `Recomendamos el <strong>Plan Gestión Activa</strong> (8 Horas - $1.200.000)`;
        if (isCustom && hours === 8) selectPlan('Crecimiento', 8, 1200000);
      } else if (hours <= 12) {
        planText = `Recomendamos el <strong>Plan Partner Total</strong> (12 Horas - $1.800.000)`;
        if (isCustom && hours === 12) selectPlan('Premium', 12, 1800000);
      } else {
        planText = `Bolsa a medida sugerida: <strong>${hours} Horas</strong> por <strong>$${price.toLocaleString('es-MX')} COP</strong> al mes.`;
      }

      recBox.innerHTML = planText;
    }

    // Efecto visual de renderizado de la firma digital
    function updateSignatureSim(val) {
      const placeholder = document.getElementById('signature-placeholder');
      const rendered = document.getElementById('signature-rendered');

      if (val.trim() === '') {
        placeholder.style.display = 'block';
        rendered.style.display = 'none';
        rendered.innerText = '';
      } else {
        placeholder.style.display = 'none';
        rendered.style.display = 'block';
        rendered.innerText = val;
      }
    }

    // Desplazamiento suave al formulario de firma
    function scrollToAcceptance() {
      document.getElementById('acceptance-area').scrollIntoView({ behavior: 'smooth' });
    }

    // Envío y registro del acuerdo comercial
    function handleAcceptanceSubmit(e) {
      e.preventDefault();

      const name = document.getElementById('signer-name').value;
      const company = document.getElementById('signer-company').value;
      
      let finalPlanDetail = '';
      if (selectedPlanName === 'Personalizado') {
        finalPlanDetail = `Bolsa Personalizada de ${selectedPlanHours} Horas al mes por un valor de $${selectedPlanPrice.toLocaleString('es-MX')} COP`;
      } else {
        finalPlanDetail = `Plan ${selectedPlanName} (${selectedPlanHours} Horas / $${selectedPlanPrice.toLocaleString('es-MX')} COP)`;
      }

      // Ocultar formulario, mostrar pantalla de éxito
      document.getElementById('form-container').style.display = 'none';
      
      const successScreen = document.getElementById('success-screen');
      successScreen.style.display = 'flex';

      const successMsg = document.getElementById('success-message');
      successMsg.innerHTML = `Propuesta formalizada para la marca <strong>${company}</strong>, autorizada digitalmente por <strong>${name}</strong> para el <strong>${finalPlanDetail}</strong>.<br><br>Se ha generado el registro y la asignación horaria en la agenda del equipo técnico de la agencia.`;

      // Generar Hash Único de aceptación
      const uniqueHash = '#SH-' + Math.floor(1000000 + Math.random() * 9000000) + '-OK';
      document.getElementById('success-hash').innerText = uniqueHash;

      // Mensaje en consola simulando trigger de correo
      console.log(`[API Trigger] Contrato creado con éxito. Firma: ${name}, Empresa: ${company}, Detalle: ${finalPlanDetail}. Hash: ${uniqueHash}`);
    }
  </script>
</body>
</html>
